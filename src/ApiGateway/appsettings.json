{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ruta-estudiantes": {
        "ClusterId": "cluster-estudiantes",
        "Match": {
          "Path": "/api/estudiantes/{**catch-all}"
        }
      },
      "ruta-cursos": {
        "ClusterId": "cluster-cursos",
        "Match": {
          "Path": "/api/cursos/{**catch-all}"
        }
      },
      "swagger-estudiantes": {
        "ClusterId": "cluster-estudiantes",
        "Match": {
          "Path": "/swagger/estudiantes/v1/swagger.json"
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      },
      "swagger-cursos": {
        "ClusterId": "cluster-cursos",
        "Match": {
          "Path": "/swagger/cursos/v1/swagger.json"
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      }
    },
    "Clusters": {
      "cluster-estudiantes": {
        "Destinations": {
          "destino1": {
            "Address": "http://localhost:5092"
          }
        }
      },
      "cluster-cursos": {
        "Destinations": {
          "destino1": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  }
}